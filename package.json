{
  "name": "landing-voda-danang",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "cross-env APP_ENV=dev astro dev",
    "build:dev": "cross-env APP_ENV=dev astro build",
    "build:prod": "cross-env APP_ENV=prod astro build",
    "preview": "cross-env APP_ENV=dev astro preview",
    "check": "cross-env APP_ENV=dev astro check",
    "lint": "eslint --flag unstable_native_nodejs_ts_config . && node scripts/lint/check-markup-comments.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets": "secretlint \"**/*\"",
    "audit:deps": "npm audit --audit-level=high",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "serve:site": "node scripts/serve-site.ts",
    "e2e": "playwright test --project=e2e",
    "smoke": "playwright test --project=smoke",
    "lighthouse": "playwright test --project=audit"
  },
  "dependencies": {
    "astro": "^7.3.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.6",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "chrome-launcher": "^1.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.12.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "satori": "^0.33.5",
    "secretlint": "^13.0.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
