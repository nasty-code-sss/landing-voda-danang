---
import BaseLayout from '../../app/layouts/BaseLayout.astro';
import { pageMeta } from '../../app/layouts/page-meta';
import { languageOptions } from '../../features/language-switch/model/language-options';
import OrderBuilder from '../../features/order-builder/ui/OrderBuilder.astro';
import { settings } from '../../shared/config/current-settings';
import { translator } from '../../shared/i18n/dictionary';
import { localBusinessJsonLd } from '../../shared/lib/local-business';
import { SITE_ROUTE } from '../../shared/lib/site-route';
import { sitePath } from '../../shared/lib/site-path';
import DeliveryZone from '../../widgets/delivery-zone/ui/DeliveryZone.astro';
import DepositExplainer from '../../widgets/deposit-explainer/ui/DepositExplainer.astro';
import Faq from '../../widgets/faq/ui/Faq.astro';
import FinalCall from '../../widgets/final-call/ui/FinalCall.astro';
import Hero from '../../widgets/hero/ui/Hero.astro';
import HowItWorks from '../../widgets/how-it-works/ui/HowItWorks.astro';
import Landlords from '../../widgets/landlords/ui/Landlords.astro';
import OrderBar from '../../widgets/order-bar/ui/OrderBar.astro';
import PriceList from '../../widgets/price-list/ui/PriceList.astro';
import PumpInfo from '../../widgets/pump-info/ui/PumpInfo.astro';
import SiteFooter from '../../widgets/site-footer/ui/SiteFooter.astro';
import SiteHeader from '../../widgets/site-header/ui/SiteHeader.astro';
import TrustPoints from '../../widgets/trust-points/ui/TrustPoints.astro';

export function getStaticPaths() {
  return settings.config.languages.supported.map((lang) => ({ params: { lang } }));
}

const { config, dictionaries } = settings;
const language = Astro.params.lang ?? config.languages.default;
const say = translator(dictionaries, language);
const languages = languageOptions(config, dictionaries);
const meta = pageMeta(settings, language, SITE_ROUTE.home);
const structuredData = localBusinessJsonLd({
  name: config.brand.name,
  description: meta.description,
  url: meta.canonical,
  image: meta.shareImage,
  telephone: config.contacts.phone,
  street: config.warehouse.street,
  city: config.warehouse.city,
  country: config.warehouse.country,
  areaServed: config.zone.map((area) => area.name),
  opens: config.delivery.opensAt,
  closes: config.delivery.closesAt,
  days: config.delivery.days,
  currency: config.money.currency,
  language,
});
---

<BaseLayout meta={meta} structuredData={structuredData}>
  <SiteHeader
    brandName={config.brand.name}
    say={say}
    homePath={sitePath(config.site.base, language)}
    language={language}
    languages={languages}
    storageKey={config.browserStorage.languageKey}
  />
  <main>
    <Hero config={config} say={say} language={language} />
    <HowItWorks config={config} say={say} language={language} />
    <DepositExplainer config={config} say={say} language={language} />
    <PriceList config={config} say={say} language={language} />
    <OrderBuilder config={config} dictionaries={dictionaries} language={language} />
    <TrustPoints config={config} say={say} />
    <PumpInfo config={config} say={say} language={language} />
    <DeliveryZone config={config} say={say} language={language} />
    <Landlords config={config} dictionaries={dictionaries} say={say} language={language} />
    <Faq config={config} say={say} language={language} />
    <FinalCall config={config} say={say} language={language} />
  </main>
  <SiteFooter config={config} dictionaries={dictionaries} say={say} language={language} languages={languages} />
  <OrderBar say={say} />
</BaseLayout>
