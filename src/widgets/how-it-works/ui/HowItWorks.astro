---
import type { SiteConfig } from '../../../shared/config/site-config';
import type { Translate } from '../../../shared/i18n/dictionary';
import { formatList } from '../../../shared/i18n/list-format';
import { fillTemplate } from '../../../shared/i18n/template';
import { PAGE_ANCHOR } from '../../../shared/lib/page-anchor';
import Icon from '../../../shared/ui/Icon.astro';
import PageSection from '../../../shared/ui/PageSection.astro';

interface Props {
  config: SiteConfig;
  say: Translate;
  language: string;
}

const { config, say, language } = Astro.props;
const messengers = formatList(
  (config.messengers.order[language] ?? []).map((id) => say(`messenger.${id}`)),
  language,
  'disjunction',
);
const payments = formatList(
  config.payments.map((payment) => say(`payment.short.${payment}`)),
  language,
  'disjunction',
);
const steps = [
  { icon: 'bottle', title: say('how.step.1.title'), text: say('how.step.1.text') },
  { icon: 'chat', title: say('how.step.2.title'), text: fillTemplate(say('how.step.2.text'), { messengers }) },
  { icon: 'scooter', title: say('how.step.3.title'), text: fillTemplate(say('how.step.3.text'), { payments }) },
] as const;
---

<PageSection anchor={PAGE_ANCHOR.howItWorks} title={say('how.title')} tone="tinted">
  <ol class="steps">
    {
      steps.map((step, index) => (
        <li class="step">
          <span class="step-badge" aria-hidden="true">
            <Icon name={step.icon} size={28} />
            <span class="step-number">{index + 1}</span>
          </span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))
    }
  </ol>
  <p class="refill-note">{say('how.refill')}</p>
</PageSection>

<style>
  .steps {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    padding: 20px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-foam);
  }

  .step-badge {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    margin-bottom: 12px;
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-sea);
  }

  .step-number {
    position: absolute;
    top: -4px;
    right: -4px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-sea);
    color: var(--color-surface);
    font-size: 0.8125rem;
    font-weight: 800;
    line-height: 1;
  }

  h3 {
    font-size: 1.125rem;
  }

  p {
    margin: 0;
    color: var(--color-muted);
  }

  .refill-note {
    margin-top: 20px;
    color: var(--color-ink);
    font-weight: 700;
  }

  @media (min-width: 760px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
