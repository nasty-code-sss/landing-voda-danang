---
import { brandsWithTap } from '../../../entities/brand/model/brand';
import { brandsFromConfig } from '../../../features/order-builder/model/builder-data';
import type { SiteConfig } from '../../../shared/config/site-config';
import type { Translate } from '../../../shared/i18n/dictionary';
import { formatList } from '../../../shared/i18n/list-format';
import { formatMoney } from '../../../shared/i18n/number-format';
import { fillTemplate } from '../../../shared/i18n/template';
import { anchorHref, PAGE_ANCHOR } from '../../../shared/lib/page-anchor';
import Icon from '../../../shared/ui/Icon.astro';
import PageSection from '../../../shared/ui/PageSection.astro';

interface Props {
  config: SiteConfig;
  say: Translate;
  language: string;
}

const { config, say, language } = Astro.props;
const brands = brandsFromConfig(config);
const namesOf = (hasTap: boolean) =>
  formatList(
    brandsWithTap(brands, hasTap).map((brand) => brand.name),
    language,
    'conjunction',
  );
const withoutTap = brandsWithTap(brands, false);
const withTap = brandsWithTap(brands, true);
---

{
  config.pumps.length > 0 && withoutTap.length > 0 && (
    <PageSection
      anchor={PAGE_ANCHOR.pump}
      title={say('pump.title')}
      intro={fillTemplate(say('pump.intro'), { brands: namesOf(false) })}
    >
      <ul class="pumps">
        {config.pumps.map((pump) => (
          <li class="pump">
            <span class="pump-icon">
              <Icon name="plug" size={28} />
            </span>
            <span class="pump-name">{say(`pump.${pump.id}`)}</span>
            <span class="pump-price">{formatMoney(pump.price, language, config.money.currency)}</span>
          </li>
        ))}
      </ul>
      <p class="pump-note">{say('pump.add_to_order')}</p>
      {withTap.length > 0 && <p class="pump-note">{fillTemplate(say('pump.tap_brands'), { brands: namesOf(true) })}</p>}
      <a class="button button-secondary" href={anchorHref(PAGE_ANCHOR.order)}>
        {say('pump.go_to_order')}
      </a>
    </PageSection>
  )
}

<style>
  .pumps {
    display: grid;
    gap: 12px;
    max-width: 560px;
    margin: 0 0 16px;
    padding: 0;
    list-style: none;
  }

  .pump {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    padding: 16px 20px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .pump-icon {
    display: flex;
    color: var(--color-sea);
  }

  .pump-name {
    flex: 1 1 auto;
    font-weight: 700;
  }

  .pump-price {
    color: var(--color-sea-dark);
    font-size: 1.25rem;
    font-weight: 800;
  }

  .pump-note {
    max-width: 60ch;
    margin: 0 0 12px;
  }

  .button {
    margin-top: 8px;
  }
</style>
