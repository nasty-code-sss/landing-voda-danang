---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { BRAND_FONT_VARIABLE } from '../../shared/config/font-variable';
import { scriptJson } from '../../shared/lib/script-json';
import { sitePath } from '../../shared/lib/site-path';
import type { PageMeta } from './page-meta';

const FAVICON_FILE = 'favicon.svg';
const OPEN_GRAPH_TYPE = 'website';
const TWITTER_CARD = 'summary_large_image';

interface Props {
  meta: PageMeta;
  structuredData?: Readonly<Record<string, unknown>> | null;
}

const { meta, structuredData = null } = Astro.props;
---

<!doctype html>
<html lang={meta.language} class="no-js" data-analytics-queue={meta.analyticsQueue}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    {meta.noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={meta.canonical} />
    {meta.alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    <link rel="icon" type="image/svg+xml" href={`${sitePath(import.meta.env.BASE_URL)}${FAVICON_FILE}`} />
    <meta property="og:type" content={OPEN_GRAPH_TYPE} />
    <meta property="og:site_name" content={meta.siteName} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={meta.canonical} />
    <meta property="og:locale" content={meta.ogLocale} />
    <meta property="og:image" content={meta.shareImage} />
    <meta property="og:image:alt" content={meta.shareImageAlt} />
    <meta name="twitter:card" content={TWITTER_CARD} />
    <Font cssVariable={BRAND_FONT_VARIABLE} preload />
    {structuredData !== null && <script type="application/ld+json" set:html={scriptJson(structuredData)} />}
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
  </head>
  <body>
    <slot />
    <script>
      import { bindTrackedElements } from '../analytics/bind-tracked-elements';

      bindTrackedElements(document);
    </script>
  </body>
</html>
