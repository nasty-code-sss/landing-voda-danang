---
import { ANALYTICS_EVENT } from '../../../shared/lib/analytics-event';
import type { LanguageOption } from '../model/language-options';

interface Props {
  current: string;
  options: readonly LanguageOption[];
  label: string;
  storageKey: string;
  landmark?: boolean;
}

const { current, options, label, storageKey, landmark = true } = Astro.props;
const Container = landmark ? 'nav' : 'div';
const containerRole = landmark ? undefined : 'group';
---

<Container class="language-switch" aria-label={label} role={containerRole} data-language-list>
  <ul>
    {options.map((option) => {
      const isCurrent = option.code === current;
      return (
        <li>
          <a
            href={option.path}
            lang={option.code}
            hreflang={option.code}
            aria-current={isCurrent ? 'page' : undefined}
            data-language-link
            data-language={option.code}
            data-path={option.path}
            data-storage-key={storageKey}
            data-analytics-click={isCurrent ? undefined : ANALYTICS_EVENT.languageSwitch}
            data-analytics-param-from={isCurrent ? undefined : current}
            data-analytics-param-to={isCurrent ? undefined : option.code}
          >
            {option.name}
          </a>
        </li>
      );
    })}
  </ul>
</Container>

<script>
  import { bindLanguageLinks } from './bind-language-links';

  document.querySelectorAll('[data-language-list]').forEach(bindLanguageLinks);
</script>

<style>
  .language-switch ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .language-switch a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--touch-target);
    min-height: var(--touch-target);
    padding: 0 12px;
    border-radius: 999px;
    color: var(--color-ink);
    font-weight: 600;
    text-decoration: none;
  }

  .language-switch a:hover {
    background: var(--color-selected);
  }

  .language-switch a[aria-current='page'] {
    background: var(--color-sea);
    color: var(--color-surface);
  }
</style>
